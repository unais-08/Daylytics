{
  "info": {
    "_postman_id": "3f6e6b76-7e17-4f98-a3f5-analytics-api",
    "name": "Personal Analytics API",
    "description": "Local Postman collection for the FastAPI personal analytics backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "sessionId",
      "value": "1"
    },
    {
      "key": "distractionId",
      "value": "1"
    },
    {
      "key": "sleepId",
      "value": "1"
    },
    {
      "key": "careerOutputId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "System",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Health is OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().status).to.eql('ok');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Today dashboard",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/today"
          }
        },
        {
          "name": "OpenAPI schema",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/openapi.json"
          }
        }
      ]
    },
    {
      "name": "Work sessions",
      "item": [
        {
          "name": "Start session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"activity\": \"DSA\"\n}"
            },
            "url": "{{baseUrl}}/sessions/start"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Session started', function () {",
                  "  pm.response.to.have.status(201);",
                  "  pm.collectionVariables.set('sessionId', pm.response.json().id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Stop session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"focus_score\": 4\n}"
            },
            "url": "{{baseUrl}}/sessions/{{sessionId}}/stop"
          }
        },
        {
          "name": "Create manual session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"activity\": \"PROJECT\",\n  \"start_time\": \"2026-10-08T08:00:00Z\",\n  \"end_time\": \"2026-10-08T09:30:00Z\",\n  \"focus_score\": 4,\n  \"deep_work\": true\n}"
            },
            "url": "{{baseUrl}}/sessions"
          }
        },
        {
          "name": "List sessions",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/sessions?start_date=2026-10-01&end_date=2026-10-08&activity=DSA"
          }
        },
        {
          "name": "Delete session",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/sessions/{{sessionId}}"
          }
        }
      ]
    },
    {
      "name": "Distractions",
      "item": [
        {
          "name": "Start distraction",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category\": \"YOUTUBE\"\n}"
            },
            "url": "{{baseUrl}}/distractions/start"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Distraction started', function () {",
                  "  pm.response.to.have.status(201);",
                  "  pm.collectionVariables.set('distractionId', pm.response.json().id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Stop distraction",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/distractions/{{distractionId}}/stop"
          }
        },
        {
          "name": "Create retroactive distraction",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category\": \"PHONE\",\n  \"minutes\": 20\n}"
            },
            "url": "{{baseUrl}}/distractions"
          }
        },
        {
          "name": "List distractions",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/distractions"
          }
        },
        {
          "name": "Delete distraction",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/distractions/{{distractionId}}"
          }
        }
      ]
    },
    {
